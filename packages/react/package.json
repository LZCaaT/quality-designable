    "@formily/reactive": "^2.3.7",
    "@formily/reactive-react": "^2.3.7",
    "antd": "^6.0.0",
    "react": ">=19.0.0 <20.0.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
