    "antd": "^6.0.0",
    "react": ">=19.0.0 <20.0.0",
    "react-dom": ">=19.0.0 <20.0.0",
    "react-is": ">=19.0.0 <20.0.0"
  },
  "engines": {
    "npm": ">=3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
