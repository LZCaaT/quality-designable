    "@formily/reactive": "^2.3.7"
  },
  "peerDependencies": {
    "@formily/json-schema": "^2.3.7",
    "@formily/path": "^2.3.7",
    "@formily/reactive": "^2.3.7"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
