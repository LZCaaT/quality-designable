  "main": "lib",
  "module": "esm",
  "types": "esm/index.d.ts",
  "files": [
    "lib",
    "esm"
  ],
  "scripts": {
    "build": "rimraf -rf lib esm dist && npm run generate:declarations && npm run build:cjs && npm run build:esm && ts-node copy",
    "build:cjs": "tsc --project tsconfig.build.json",
    "build:esm": "tsc --project tsconfig.build.json --module es2015 --outDir esm",
    "generate:declarations": "ts-node generate-declarations",
    "start": "webpack-dev-server --config playground/webpack.dev.ts"
  },
  "dependencies": {
    "@designable-next/core": "0.1.0-alpha.3",
    "@designable-next/formily-transformer": "0.1.0-alpha.3",
    "@designable-next/react": "0.1.0-alpha.3",
    "@designable-next/react-settings-form": "0.1.0-alpha.3"
  },
  "devDependencies": {
    "@designable-next/formily-antd-v6": "file:../../../quality-formily-antd-v6/packages/components",
    "@formily/core": "^2.3.7",
    "@formily/react": "^2.3.7",
    "@formily/shared": "^2.3.7",
    "antd": "^6.0.0"
  },
  "peerDependencies": {
    "@designable-next/formily-antd-v6": ">=0.1.0-alpha.2 <0.2.0",
    "@formily/react": "^2.3.7",
