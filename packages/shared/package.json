  "homepage": "https://github.com/LZCaaT/quality-designable#readme",
  "bugs": {
    "url": "https://github.com/LZCaaT/quality-designable/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LZCaaT/quality-designable.git"
  },
  "license": "MIT",
  "main": "lib",
  "module": "esm",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "esm"
  ],
  "scripts": {
    "build": "rimraf -rf lib esm dist && npm run build:cjs && npm run build:esm && npm run build:umd",
    "build:cjs": "tsc --project tsconfig.build.json",
    "build:esm": "tsc --project tsconfig.build.json --module es2015 --outDir esm",
    "build:umd": "rollup --config"
  },
  "dependencies": {
    "requestidlecallback": "^0.3.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
